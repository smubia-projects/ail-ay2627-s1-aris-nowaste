{
  "name": "nowaste",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:server": "tsx watch --env-file-if-exists=.env server/server.ts",
    "build:server": "esbuild server/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=server/dist/server.js --log-level=warning",
    "start:server": "node server/dist/server.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@types/leaflet": "^1.9.22",
    "@upstash/redis": "^1.39.0",
    "cors": "^2.8.6",
    "date-fns": "4.1.0",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "next": "16.4.5",
    "openai": "7.28.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "^0.25.12",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "6.1.0",
    "vitest": "3.0.9"
  }
}
