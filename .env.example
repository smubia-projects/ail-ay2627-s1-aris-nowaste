# AI Lodge showcase. Two parts, two env files:
#   .env        the API (server/, Cloud Run): every key below except NEXT_PUBLIC_API_BASE
#   .env.local  the Next.js app (Vercel): only NEXT_PUBLIC_API_BASE
# No Supabase, Telegram, USDA or cron keys: the demo keeps the pantry in the browser (originals in original-supabase/).

# --- Next.js app (Vercel) ---
# The API's URL (Cloud Run). Local: http://localhost:8080
NEXT_PUBLIC_API_BASE=

# --- AI (any OpenAI-compatible chat-completions gateway; AI Lodge uses apiyi). SERVER ONLY. ---
API_BASE_URL=https://api.apiyi.com/v1
# This project's own key (AI Lodge key bot). Old name OPENAI_API_KEY still works.
API_KEY=
# Text model: rescue recipes (JSON mode + zod). Old name OPENAI_MODEL still works.
MODEL_NAME=deepseek-v4-1-flash-260910
# Vision model: reading receipts (JSON mode + zod). Must read images: deepseek-v4-1-flash-260910 does,
# the older deepseek-v4-flash silently ignores them.
VISION_MODEL_NAME=deepseek-v4-1-flash-260910

# Comma-separated browser origins allowed to call the API (the Vercel URL in production)
CORS_ORIGINS=http://localhost:3000

# --- AI Lodge rate limit (fallbacks; the central control sheet overrides them) ---
# Upstash keys come from the batch's shared env, not this file.
RATE_LIMIT_RECEIPT_MAX=4
RATE_LIMIT_RECIPES_MAX=6
RATE_LIMIT_WINDOW_SECONDS=432000
